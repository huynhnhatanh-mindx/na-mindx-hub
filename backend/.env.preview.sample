# =========================================================================
#                    CẤU HÌNH CHO MÔI TRƯỜNG PREVIEW / STAGING (RENDER & VERCEL)
# =========================================================================
PORT=5000
NODE_ENV=staging

# Lựa chọn phương thức lưu trữ mặc định: 'google-drive' hoặc 'local'
STORAGE_PROVIDER=local

# Cấu hình Cơ sở dữ liệu Preview (Nên dùng DB Atlas riêng cho Staging/Preview)
MONGODB_URI=YOUR_PREVIEW_MONGODB_ATLAS_CONNECTION_STRING
ADMIN_PASSCODE=YOUR_PREVIEW_ADMIN_PASSCODE
JWT_SECRET=YOUR_PREVIEW_JWT_SECRET_KEY

# Cấu hình Google Drive OAuth (Callback domain preview)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://na-mindx-hub-preview.onrender.com/api/auth/google/callback

# Cấu hình gửi Email (Resend)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
FEEDBACK_EMAIL=onboarding@resend.dev
FEEDBACK_EMAIL_PASS=re_YOUR_RESEND_API_KEY

# URL Frontend Preview (Vercel Preview URL hoặc Wildcard CORS)
FRONTEND_URL=https://na-mindx-hub-preview.vercel.app
